<script>
jQuery(function ($) {

   const form = document.getElementById('pr_generator_form');
const output = document.getElementById('gnn-pr-output');
const actions = document.getElementById('gnn-pr-actions');

if (!form || !output) return;


    /* =========================================================
       FIELD READER
       ========================================================= */

    function getValue(fieldId) {

        const field = document.getElementById(
            'form-field-' + fieldId
        );

        return field
            ? String(field.value || '').trim()
            : '';
    }


    /* =========================================================
       TARGET AUDIENCE
       ========================================================= */

    function getTargetAudience() {

        const values = [];

        form.querySelectorAll(
            'input[id*="target_audience"],' +
            'select[id*="target_audience"],' +
            'textarea[id*="target_audience"]'
        ).forEach(function (field) {

            if (
                field.type === 'checkbox' &&
                !field.checked
            ) {
                return;
            }

            if (
                field.value &&
                String(field.value).trim()
            ) {
                values.push(
                    String(field.value).trim()
                );
            }

        });

        return values.join(', ');
    }


    /* =========================================================
       HTML ESCAPE
       ========================================================= */

    function escapeHtml(value) {

        const div =
            document.createElement('div');

        div.textContent =
            value || '';

        return div.innerHTML;
    }


    /* =========================================================
       LINK PARSER
       ========================================================= */

    function normalizeUrl(url) {

        if (!url) return '';

        url = String(url).trim();

        if (!/^https?:\/\//i.test(url)) {
            url = 'https://' + url;
        }

        try {
            const parsed = new URL(url);

            if (
                parsed.protocol !== 'http:' &&
                parsed.protocol !== 'https:'
            ) {
                return '';
            }

            return parsed.href;

        } catch (e) {
            return '';
        }
    }


    /* =========================================================
       LOADING EXPERIENCE
       ========================================================= */

    /* =========================================================
       LOADING EXPERIENCE
       ========================================================= */

    let loadingInterval = null;
    let loadingStep = 0;
    let loadingStart = 0;
    let isGenerating = false;

    const loadingMessages = [
        'Reviewing the information you provided…',
        'Structuring the announcement…',
        'Writing the press release…',
        'Refining the newsroom language…',
        'Improving clarity and flow…',
        'Checking the release for repetition…',
        'Finalising your press release…'
    ];

    const loadingSteps = [
        'Reviewing your information',
        'Structuring the announcement',
        'Writing the release',
        'Refining language',
        'Checking quality',
        'Finalising the release'
    ];


    function showLoading() {

        loadingStep = 0;
        loadingStart = Date.now();
        isGenerating = true;
        
         if (actions) {
        actions.hidden = true;
    }

        output.innerHTML = `
            <div class="gnn-pr-loading">

                <div class="gnn-pr-ai-orb">
                    ✦
                </div>

                <div class="gnn-pr-loading__label">
                    GNN AI PRESS RELEASE GENERATOR
                </div>

                <div class="gnn-pr-loading__title">
                    Preparing your press release
                </div>

                <div
                    class="gnn-pr-loading__status"
                    id="gnn-pr-loading-status"
                >
                    ${loadingMessages[0]}
                </div>

                <div class="gnn-pr-loading__steps">

                    ${loadingSteps.map(function (step, index) {

                        return `
                            <div
                                class="gnn-pr-loading__step ${
                                    index === 0
                                        ? 'is-active'
                                        : ''
                                }"
                                data-step="${index}"
                            >
                                <span class="gnn-pr-loading__dot"></span>
                                ${step}
                            </div>
                        `;

                    }).join('')}

                </div>

                <div
                    class="gnn-pr-progress"
                    aria-hidden="true"
                >
                    <div class="gnn-pr-progress__bar"></div>
                </div>

                <div
                    class="gnn-pr-loading__timer"
                    id="gnn-pr-loading-timer"
                >
                    0 seconds
                </div>

            </div>
        `;


        const status =
            document.getElementById(
                'gnn-pr-loading-status'
            );

        const timer =
            document.getElementById(
                'gnn-pr-loading-timer'
            );

        const steps =
            output.querySelectorAll(
                '.gnn-pr-loading__step'
            );


        /*
         * This animation is deliberately independent
         * of the actual AI process.
         *
         * It indicates activity rather than claiming
         * that a specific AI operation has completed.
         */

        loadingInterval = setInterval(function () {

            const elapsed =
                Math.floor(
                    (Date.now() - loadingStart) / 1000
                );


            /* Elapsed time */

            if (timer) {

                timer.textContent =
                    elapsed +
                    (
                        elapsed === 1
                            ? ' second'
                            : ' seconds'
                    );
            }


            /*
             * Rotate the visual workflow.
             *
             * We intentionally do not display a
             * numerical completion percentage.
             */

            const nextStep =
                Math.min(
                    5,
                    Math.floor(elapsed / 6)
                );


            if (
                nextStep !== loadingStep
            ) {

                loadingStep =
                    nextStep;


                steps.forEach(
                    function (step, index) {

                        step.classList.remove(
                            'is-active',
                            'is-complete'
                        );


                        if (
                            index < loadingStep
                        ) {

                            step.classList.add(
                                'is-complete'
                            );
                        }


                        if (
                            index === loadingStep
                        ) {

                            step.classList.add(
                                'is-active'
                            );
                        }

                    }
                );


                if (status) {

                    status.style.opacity =
                        '0';


                    setTimeout(function () {

                        status.textContent =
                            loadingMessages[
                                Math.min(
                                    loadingStep,
                                    loadingMessages.length - 1
                                )
                            ];


                        status.style.opacity =
                            '1';

                    }, 180);
                }
            }

        }, 1000);
    }


    function stopLoading() {

        if (loadingInterval) {

            clearInterval(
                loadingInterval
            );

            loadingInterval = null;
        }

        isGenerating = false;
    }


    /* =========================================================
       ERROR
       ========================================================= */

    function showError(message) {

        stopLoading();
        
         if (actions) {
        actions.hidden = true;
    }

        output.innerHTML = `
            <div class="gnn-pr-empty-state">

                <span class="gnn-pr-empty-state__label">
                    GENERATION ERROR
                </span>

                <strong>
                    We couldn't generate the press release.
                </strong>

                <p>
                    ${escapeHtml(message)}
                </p>

                <p style="margin-top:14px;">
                    Please review the information and try again.
                </p>

            </div>
        `;
    }


    /* =========================================================
       PARAGRAPHS
       ========================================================= */

    function addParagraphs(parent, paragraphs) {

        if (!Array.isArray(paragraphs)) {
            return;
        }

        paragraphs.forEach(function (text) {

            if (
                !text ||
                !String(text).trim()
            ) {
                return;
            }

            const p =
                document.createElement('p');

            p.textContent =
                String(text).trim();

            parent.appendChild(p);

        });
    }


    /* =========================================================
       STRUCTURED SECTIONS
       ========================================================= */

    function renderSections(parent, sections) {

        if (!Array.isArray(sections)) {
            return false;
        }

        let rendered = false;

        sections.forEach(function (section) {

            if (!section) {
                return;
            }

            const headingText =
                section.heading
                    ? String(section.heading).trim()
                    : '';

            const paragraphs =
                Array.isArray(section.paragraphs)
                    ? section.paragraphs
                    : [];


            if (
                !headingText &&
                !paragraphs.length
            ) {
                return;
            }


            const wrapper =
                document.createElement('section');

            wrapper.className =
                'gnn-pr-section';


            if (headingText) {

                const heading =
                    document.createElement('h2');

                heading.textContent =
                    headingText;

                wrapper.appendChild(
                    heading
                );
            }


            addParagraphs(
                wrapper,
                paragraphs
            );


            parent.appendChild(
                wrapper
            );

            rendered = true;

        });

        return rendered;
    }


    /* =========================================================
       GENERATED ARTICLE
       ========================================================= */

    function renderArticle(data) {

        stopLoading();

        output.replaceChildren();

        const article =
            document.createElement('article');


        /* =====================================================
           FOR IMMEDIATE RELEASE + DATE
           ===================================================== */

        const releaseLine =
            document.createElement('div');

        releaseLine.className =
            'gnn-pr-release-line';

        releaseLine.textContent =
            'For Immediate Release' +
            (
                data.date
                    ? ' · ' + data.date
                    : ''
            );

        article.appendChild(
            releaseLine
        );


        /* =====================================================
           CITY / ANNOUNCEMENT TYPE
           ===================================================== */

        if (
            data.announcement_type ||
            data.city
        ) {

            const meta =
                document.createElement('div');

            meta.className =
                'gnn-pr-meta';

            const metaParts = [];

            if (data.announcement_type) {
                metaParts.push(
                    data.announcement_type
                );
            }

            if (data.city) {
                metaParts.push(
                    data.city
                );
            }

            meta.textContent =
                metaParts.join(' · ');

            article.appendChild(
                meta
            );
        }


        /* =====================================================
           MAIN HEADLINE
           ===================================================== */

        const title =
            document.createElement('h1');

        title.textContent =
            data.headline ||
            'Generated Press Release';

        article.appendChild(
            title
        );


        /* =====================================================
           SUBHEADLINE
           ===================================================== */

        if (
            data.sub_headline
        ) {

            const subheadline =
                document.createElement('div');

            subheadline.className =
                'gnn-pr-subheadline';

            subheadline.textContent =
                data.sub_headline;

            article.appendChild(
                subheadline
            );
        }


        /* =====================================================
           IMAGE
           ===================================================== */

        if (data.image_url) {

            const imageUrl =
                normalizeUrl(
                    data.image_url
                );

            if (imageUrl) {

                const image =
                    document.createElement('img');

                image.className =
                    'gnn-pr-image';

                image.src =
                    imageUrl;

                image.alt =
                    data.headline ||
                    'Press release image';

                image.loading =
                    'lazy';

                image.referrerPolicy =
                    'no-referrer';

                image.onerror =
                    function () {
                        image.remove();
                    };

                article.appendChild(
                    image
                );
            }
        }


        /* =====================================================
           DATELINE
           ===================================================== */

        if (
            data.dateline
        ) {

            const dateline =
                document.createElement('p');

            dateline.textContent =
                data.dateline;

            article.appendChild(
                dateline
            );
        }


        /* =====================================================
           BODY / STRUCTURED SECTIONS
           ===================================================== */

        const hasStructuredSections =
            renderSections(
                article,
                data.sections
            );


        /*
         * Backward compatibility:
         * If the backend does not yet return
         * structured sections, continue using
         * the existing body array.
         */

        if (!hasStructuredSections) {

            addParagraphs(
                article,
                data.body
            );
        }


        /* =====================================================
           KEY HIGHLIGHTS
           ===================================================== */

        if (
            Array.isArray(
                data.key_highlights
            ) &&
            data.key_highlights.length
        ) {

            const heading =
                document.createElement('h2');

            heading.textContent =
                'Key Highlights';

            article.appendChild(
                heading
            );


            const list =
                document.createElement('ul');


            data.key_highlights.forEach(
                function (point) {

                    if (!point) return;

                    const item =
                        document.createElement('li');

                    item.textContent =
                        String(point).trim();

                    list.appendChild(
                        item
                    );

                }
            );


            article.appendChild(
                list
            );
        }


        /* =====================================================
           EXECUTIVE COMMENT
           ===================================================== */

        if (
            data.executive_comment
        ) {

            const heading =
                document.createElement('h2');

            heading.textContent =
                'Executive Comment';

            article.appendChild(
                heading
            );


            const quote =
                document.createElement(
                    'blockquote'
                );

            quote.textContent =
                data.executive_comment;

            article.appendChild(
                quote
            );
        }


        /* =====================================================
           ABOUT COMPANY
           ===================================================== */

        if (
            data.about_company
        ) {

            const company =
                data.company_name ||
                getValue('company_name') ||
                'Company';


            const heading =
                document.createElement('h2');

            heading.textContent =
                'About ' + company;

            article.appendChild(
                heading
            );


            const about =
                document.createElement('p');

            about.textContent =
                data.about_company;

            article.appendChild(
                about
            );
        }


        /* =====================================================
           MEDIA CONTACT
           ===================================================== */

        if (
            data.business_email
        ) {

            const contact =
                document.createElement(
                    'div'
                );

            contact.className =
                'gnn-pr-contact';

            contact.innerHTML =
                '<strong>Media Contact</strong><br>' +
                escapeHtml(
                    data.business_email
                );

            article.appendChild(
                contact
            );
        }


        /* =====================================================
           RELEVANT LINKS
           ===================================================== */

        if (
            Array.isArray(
                data.relevant_links
            ) &&
            data.relevant_links.length
        ) {

            const linksWrapper =
                document.createElement(
                    'div'
                );

            linksWrapper.className =
                'gnn-pr-links';

            const heading =
                document.createElement(
                    'strong'
                );

            heading.textContent =
                'More Information';

            linksWrapper.appendChild(
                heading
            );


            data.relevant_links.forEach(
                function (url) {

                    const normalized =
                        normalizeUrl(url);

                    if (!normalized) {
                        return;
                    }

                    const br =
                        document.createElement(
                            'br'
                        );

                    const link =
                        document.createElement(
                            'a'
                        );

                    link.href =
                        normalized;

                    link.target =
                        '_blank';

                    link.rel =
                        'noopener noreferrer';

                    link.textContent =
                        normalized;

                    linksWrapper.appendChild(
                        br
                    );

                    linksWrapper.appendChild(
                        link
                    );
                }
            );


            article.appendChild(
                linksWrapper
            );
        }


        /* =====================================================
           WORD COUNT
           ===================================================== */

        if (
            typeof data.word_count !==
            'undefined'
        ) {

            const count =
                document.createElement(
                    'div'
                );

            count.className =
                'gnn-pr-word-count';

            count.textContent =
                data.word_count +
                ' words';

            article.appendChild(
                count
            );
        }


        output.appendChild(
            article
        );
        
        /* Show action buttons after successful generation */
if (actions) {
    actions.hidden = false;
}


        window.scrollTo({

            top:
                output.getBoundingClientRect()
                    .top +
                window.scrollY -
                80,

            behavior:
                'smooth'
        });
    }


    /* =========================================================
       SUBMIT
       ========================================================= */

    form.addEventListener(
        'submit',
        async function (event) {

            event.preventDefault();
            event.stopImmediatePropagation();

            if (isGenerating) {
                return;
            }


            if (
                !form.reportValidity()
            ) {
                return;
            }


            /* =================================================
               PAYLOAD
               ================================================= */

            const payload = {

                /* Existing fields */

                company_name:
                    getValue(
                        'company_name'
                    ),

                headline:
                    getValue(
                        'headline'
                    ),

                announcement_type:
                    getValue(
                        'announcement_type'
                    ),

                city:
                    getValue(
                        'city'
                    ),

                core_message:
                    getValue(
                        'core_message'
                    ),

                key_points:
                    getValue(
                        'key_points'
                    ),

                target_audience:
                    getTargetAudience(),

                executive_quote:
                    getValue(
                        'executive_quote'
                    ),

                business_email:
                    getValue(
                        'business_email'
                    ),

                about_company:
                    getValue(
                        'about_company'
                    ),


                /* New fields */

                announcement_date:
                    getValue(
                        'announcement_date'
                    ),

                sub_headline:
                    getValue(
                        'sub_headline'
                    ),

                image_url:
                    getValue(
                        'pr_image'
                    ),

                relevant_links:
                    getValue(
                        'relevant_links'
                    )

            };


            showLoading();


            /*
             * Frontend safety timeout.
             *
             * The WordPress AI Client remains configured
             * for the longer server-side timeout.
             *
             * This limits the visitor-facing wait to
             * 60 seconds without changing the backend
             * AI timeout.
             */

            const controller =
                new AbortController();

            const timeoutId =
                setTimeout(
                    function () {
                        controller.abort();
                    },
                    120000
                );


            try {

                const response =
                    await fetch(
                        '/wp-json/gnn/v1/generate-pr',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            signal:
                                controller.signal,

                            body:
                                JSON.stringify(
                                    payload
                                )
                        }
                    );


                clearTimeout(
                    timeoutId
                );


                let result;

                try {

                    result =
                        await response.json();

                } catch (jsonError) {

                    throw new Error(
                        'The generator returned an invalid response.'
                    );
                }


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message ||
                        'AI generation failed.'
                    );
                }


                if (
                    !result.press_release
                ) {

                    throw new Error(
                        'The AI returned an incomplete press release.'
                    );
                }


                renderArticle({

                    ...result.press_release,

                    word_count:
                        result.word_count

                });


            } catch (error) {

                clearTimeout(
                    timeoutId
                );

                console.error(
                    'GNN AI Generator:',
                    error
                );


                if (
                    error.name ===
                    'AbortError'
                ) {

                    showError(
                        'The generation request took longer than 120 seconds. Please try again. Your information has not been lost.'
                    );

                } else {

                    showError(
                        error.message ||
                        'Please try again.'
                    );
                }
            }

        },
        true
    );

});
</script>



<script>
jQuery(function ($) {
  const output = document.getElementById('gnn-pr-output');

  /* Replace these values */
  const adminEmail = 'hello@germannewsnetwork.com';
  const adminWhatsApp = '919870527870';
  /* Example WhatsApp format: 919876543210 — no +, spaces, or symbols */

  function getGeneratedArticle() {
    return output ? output.querySelector('article') : null;
  }

  function getGeneratedText() {
    const article = getGeneratedArticle();
    return article ? article.innerText.trim() : '';
  }

  function requireGeneratedOutput() {
    const text = getGeneratedText();

    if (!text) {
      alert('Please generate your press release before using this option.');
      output.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return null;
    }

    return text;
  }

  /* Opens a prefilled email draft for the visitor to review and send */
  $('#gnn-pr-email').on('click', function (event) {
    event.preventDefault();

    const text = requireGeneratedOutput();
    if (!text) return;

    const headline =
      getGeneratedArticle().querySelector('h1')?.innerText ||
      'Generated Press Release';

    const subject = 'Press Release Submission: ' + headline;
    const body = 'A press release was generated on German News Network:\n\n' + text;

    window.location.href =
      'mailto:' + adminEmail +
      '?subject=' + encodeURIComponent(subject) +
      '&body=' + encodeURIComponent(body);
  });

  /* Opens a WhatsApp message for the visitor to review and send */
  $('#gnn-pr-whatsapp').on('click', function (event) {
    event.preventDefault();

    const text = requireGeneratedOutput();
    if (!text) return;

    const message =
      'Press Release Submission – German News Network\n\n' + text;

    window.open(
      'https://wa.me/' + adminWhatsApp +
      '?text=' + encodeURIComponent(message),
      '_blank',
      'noopener'
    );
  });

  /* Downloads a Word-compatible .doc document */
  $('#gnn-pr-download').on('click', function (event) {
    event.preventDefault();

    const article = getGeneratedArticle();
    const text = requireGeneratedOutput();
    if (!article || !text) return;

    const headline =
      article.querySelector('h1')?.innerText ||
      'press-release';

    const documentHtml = `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <title>${headline}</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            max-width: 760px;
            margin: 45px auto;
            color: #252327;
            font-size: 12pt;
            line-height: 1.7;
          }
          h1 {
            font-size: 25pt;
            line-height: 1.2;
            margin-bottom: 12px;
          }
          h2 {
            font-size: 16pt;
            margin-top: 28px;
          }
          .gnn-pr-meta {
            color: #bd6510;
            font-weight: bold;
            text-transform: uppercase;
          }
          blockquote {
            margin: 20px 0;
            padding: 14px;
            border-left: 4px solid #e27d14;
            background: #fffaf5;
            font-style: italic;
          }
        </style>
      </head>
      <body>${article.innerHTML}</body>
      </html>`;

    const blob = new Blob(
      ['\ufeff', documentHtml],
      { type: 'application/msword' }
    );

    const downloadLink = document.createElement('a');
    const safeFilename = headline
      .replace(/[^a-z0-9]+/gi, '-')
      .replace(/^-+|-+$/g, '')
      .toLowerCase();

    downloadLink.href = URL.createObjectURL(blob);
    downloadLink.download = (safeFilename || 'press-release') + '.doc';
    document.body.appendChild(downloadLink);
    downloadLink.click();
    downloadLink.remove();

    setTimeout(() => URL.revokeObjectURL(downloadLink.href), 1000);
  });
});
</script>
