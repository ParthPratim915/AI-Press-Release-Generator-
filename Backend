PROMPT;


	/* =========================================================
	 * AI GENERATION — SINGLE PASS
	 * =========================================================
	 *
	 * IMPORTANT:
	 *
	 * This intentionally uses the plain WordPress AI Client
	 * generate_text() path.
	 *
	 * No JSON schema.
	 * No model preference.
	 * No extra generation.
	 * ========================================================= */

	try {

		$result =
			wp_ai_client_prompt(
				$prompt
			)->generate_text();

	} catch ( Throwable $e ) {

		return new WP_Error(
			'gnn_ai_generation_failed',
			'The AI service could not generate the press release. Please try again.',
			array(
				'status' => 502,
			)
		);

	}


	/* =========================================================
	 * CHECK AI RESULT
	 * ========================================================= */

	if ( is_wp_error( $result ) ) {

		return new WP_Error(
			'gnn_ai_generation_failed',
			$result->get_error_message(),
			array(
				'status' => 502,
			)
		);

	}


	/* =========================================================
	 * DECODE AI JSON
	 * ========================================================= */

	$data =
		gnn_decode_ai_json(
			$result
		);


	if ( ! is_array( $data ) ) {

		return new WP_Error(
			'gnn_invalid_ai_response',
			'The AI returned an invalid response. Please try again.',
			array(
				'status' => 502,
			)
		);

	}


	/* =========================================================
	 * NORMALIZE
	 * ========================================================= */

	$data =
		gnn_normalize_press_release(
			$data,
			$company,
			$headline,
			$sub_headline,
			$announcement_type,
			$announcement_date,
			$city,
			$image_url,
			$executive_quote,
			$business_email,
			$about_company,
			$relevant_links
		);


	/* =========================================================
	 * EXACTLY FOUR SECTIONS
	 * =========================================================
	 *
	 * The AI is instructed to produce four sections.
	 *
	 * This is only a structural safety check.
	 *
	 * It does NOT perform another AI request.
	 * ========================================================= */

	if (
		! isset( $data['sections'] ) ||
		! is_array( $data['sections'] ) ||
		4 !== count( $data['sections'] )
	) {

		return new WP_Error(
			'gnn_invalid_sections',
			'The AI did not return the required four-section press release. Please generate again.',
			array(
				'status' => 422,
			)
		);

	}


	/* =========================================================
	 * COUNT MAIN EDITORIAL WORDS
	 * =========================================================
	 *
	 * IMPORTANT:
	 *
	 * This counter is INFORMATIONAL ONLY.
	 *
	 * There is NO minimum rejection.
	 * There is NO maximum rejection.
	 * There is NO second AI request.
	 * ========================================================= */

	$word_count =
		gnn_count_press_release_words(
			$data
		);


	/* =========================================================
	 * FINAL RESPONSE
	 * ========================================================= */

	return new WP_REST_Response(

		array(

			'success' =>
				true,

			'word_count' =>
				$word_count,

			'press_release' =>
				$data,

		),

		200

	);

}


/**
 * =========================================================
 * DECODE AI JSON
 * =========================================================
 *
 * Handles:
 *
 * - plain JSON
 * - JSON inside Markdown fences
 * - JSON surrounded by accidental text
 * =========================================================
 */

function gnn_decode_ai_json( $text ) {


	$text =
		trim(
			(string) $text
		);


	/* ---------------------------------------------------------
	 * Remove Markdown JSON fences
	 * --------------------------------------------------------- */

	$text =
		preg_replace(
			'/^\s*```(?:json)?\s*/i',
			'',
			$text
		);


	$text =
		preg_replace(
			'/\s*```\s*$/i',
			'',
			$text
		);


	$text =
		trim(
			$text
		);


	/* ---------------------------------------------------------
	 * Direct JSON decode
	 * --------------------------------------------------------- */

	$data =
		json_decode(
			$text,
			true
		);


	if (
		is_array(
			$data
		)
	) {

		return $data;

	}


	/* ---------------------------------------------------------
	 * Defensive JSON extraction
	 * --------------------------------------------------------- */

	if (
		preg_match(
			'/\{.*\}/s',
			$text,
			$matches
		)
	) {

		$data =
			json_decode(
				$matches[0],
				true
			);


		if (
			is_array(
				$data
			)
		) {

			return $data;

		}

	}


	return null;

}


/**
 * =========================================================
 * NORMALIZE PRESS RELEASE
 * =========================================================
 */

function gnn_normalize_press_release(
	$data,
	$company,
	$headline,
	$sub_headline,
	$announcement_type,
	$date,
	$city,
	$image_url,
	$executive_quote,
	$business_email,
	$about_company,
	$relevant_links
) {


	/* ---------------------------------------------------------
	 * FIXED SECTION HEADINGS
	 * --------------------------------------------------------- */

	$fixed_headings =
		array(

			'Opening',

			'Key Development',

			'Context and Significance',

			'Company Outlook',

		);


	$sections =
		array();


	$body =
		array();


	/* ---------------------------------------------------------
	 * READ AI SECTIONS
	 * --------------------------------------------------------- */

	if (
		isset( $data['sections'] ) &&
		is_array( $data['sections'] )
	) {


		foreach (
			array_slice(
				$data['sections'],
				0,
				4
			) as $index => $section
		) {


			if (
				! is_array( $section )
			) {

				$section =
					array();

			}


			$paragraphs =
				array();


			/* -------------------------------------------------
			 * READ SECTION PARAGRAPHS
			 * ------------------------------------------------- */

			if (
				isset( $section['paragraphs'] ) &&
				is_array( $section['paragraphs'] )
			) {


				foreach (
					$section['paragraphs'] as $paragraph
				) {


					if (
						! is_scalar( $paragraph )
					) {

						continue;

					}


					$paragraph =
						sanitize_textarea_field(
							$paragraph
						);


					$paragraph =
						trim(
							$paragraph
						);


					if (
						'' !== $paragraph
					) {

						$paragraphs[] =
							$paragraph;


						$body[] =
							$paragraph;

					}

				}

			}


			/*
			 * Keep the four sections even if one happens to be
			 * empty. The frontend always receives the expected
			 * fixed structure.
			 */

			$sections[] =
				array(

					'heading' =>
						$fixed_headings[ $index ],

					'paragraphs' =>
						$paragraphs,

				);

		}

	}


	/* ---------------------------------------------------------
	 * ENSURE FOUR SECTION OBJECTS EXIST
	 * --------------------------------------------------------- */

	while (
		count( $sections ) < 4
	) {

		$index =
			count( $sections );


		$sections[] =
			array(

				'heading' =>
					$fixed_headings[ $index ],

				'paragraphs' =>
					array(),

			);

	}


	/* ---------------------------------------------------------
	 * REBUILD BODY FROM SECTIONS
	 * --------------------------------------------------------- */

	$body =
		array();


	foreach (
		$sections as $section
	) {

		if (
			isset( $section['paragraphs'] ) &&
			is_array( $section['paragraphs'] )
		) {

			foreach (
				$section['paragraphs'] as $paragraph
			) {

				if (
					is_scalar( $paragraph )
				) {

					$body[] =
						(string) $paragraph;

				}

			}

		}

	}


	/* ---------------------------------------------------------
	 * KEY HIGHLIGHTS
	 * --------------------------------------------------------- */

	$highlights =
		array();


	if (
		isset( $data['key_highlights'] ) &&
		is_array( $data['key_highlights'] )
	) {


		foreach (
			$data['key_highlights'] as $point
		) {


			if (
				! is_scalar( $point )
			) {

				continue;

			}


			$point =
				sanitize_text_field(
					$point
				);


			$point =
				trim(
					$point
				);


			if (
				'' !== $point
			) {

				$highlights[] =
					$point;

			}


			if (
				count( $highlights ) >= 5
			) {

				break;

			}

		}

	}


	/* ---------------------------------------------------------
	 * EXECUTIVE COMMENT
	 * --------------------------------------------------------- */

	$executive_comment =
		'';


	if (
		isset( $data['executive_comment'] ) &&
		is_scalar( $data['executive_comment'] )
	) {


		$executive_comment =
			sanitize_textarea_field(
				$data['executive_comment']
			);


		$executive_comment =
			trim(
				$executive_comment
			);

	}


	/*
	 * Never allow an AI-created quote when the client
	 * supplied no quote.
	 */

	if (
		'' === trim(
			(string) $executive_quote
		)
	) {

		$executive_comment =
			'';

	}


	/* ---------------------------------------------------------
	 * RELEVANT LINKS
	 * --------------------------------------------------------- */

	$supplied_links =
		array();


	if (
		'' !== trim(
			$relevant_links
		)
	) {


		$raw_links =
			preg_split(
				'/[\r\n,\s]+/',
				$relevant_links
			);


		foreach (
			$raw_links as $link
		) {


			$link =
				trim(
					$link
				);


			if (
				filter_var(
					$link,
					FILTER_VALIDATE_URL
				)
			) {

				$supplied_links[] =
					esc_url_raw(
						$link
					);

			}

		}

	}


	/*
	 * Never trust AI-generated links.
	 *
	 * Only return URLs supplied by the client.
	 */

	$links =
		array_values(
			array_unique(
				$supplied_links
			)
		);


	/* ---------------------------------------------------------
	 * IMAGE URL
	 * --------------------------------------------------------- */

	/*
	 * The supplied image URL is authoritative.
	 *
	 * The AI cannot replace it.
	 */

	$final_image_url =
		$image_url;


	/* ---------------------------------------------------------
	 * HEADLINE
	 * --------------------------------------------------------- */

	$final_headline =
		sanitize_text_field(
			$data['headline'] ?? ''
		);


	if (
		'' === trim(
			$final_headline
		)
	) {

		$final_headline =
			$headline
			? $headline
			: $company .
				' Announces Company Update';

	}


	/* ---------------------------------------------------------
	 * SUBHEADLINE
	 * --------------------------------------------------------- */

	$final_sub_headline =
		sanitize_text_field(
			$data['sub_headline'] ?? ''
		);


	if (
		'' === trim(
			$final_sub_headline
		) &&
		'' !== trim(
			$sub_headline
		)
	) {

		$final_sub_headline =
			$sub_headline;

	}


	/* ---------------------------------------------------------
	 * ANNOUNCEMENT TYPE
	 * --------------------------------------------------------- */

	$final_announcement_type =
		sanitize_text_field(
			$data['announcement_type'] ??
			$announcement_type
		);


	if (
		'' === trim(
			$final_announcement_type
		)
	) {

		$final_announcement_type =
			$announcement_type;

	}


	/* ---------------------------------------------------------
	 * DATE
	 * --------------------------------------------------------- */

	$final_date =
		sanitize_text_field(
			$data['date'] ??
			$date
		);


	if (
		'' === trim(
			$final_date
		)
	) {

		$final_date =
			$date;

	}


	/* ---------------------------------------------------------
	 * CITY
	 * --------------------------------------------------------- */

	$final_city =
		sanitize_text_field(
			$data['city'] ??
			$city
		);


	if (
		'' === trim(
			$final_city
		)
	) {

		$final_city =
			$city;

	}


	/* ---------------------------------------------------------
	 * DATELINE
	 * --------------------------------------------------------- */

	$dateline =
		'';


	if (
		isset( $data['dateline'] ) &&
		is_scalar( $data['dateline'] )
	) {

		$dateline =
			sanitize_text_field(
				$data['dateline']
			);


		$dateline =
			trim(
				$dateline
			);

	}


	/*
	 * Deterministic fallback from supplied city.
	 */

	if (
		'' === $dateline &&
		'' !== trim( $city )
	) {

		$dateline =
			strtoupper(
				$city
			) .
			' —';

	}


	/* ---------------------------------------------------------
	 * ABOUT COMPANY
	 * --------------------------------------------------------- */

	$final_about_company =
		sanitize_textarea_field(
			$data['about_company'] ??
			$about_company
		);


	if (
		'' === trim(
			$final_about_company
		)
	) {

		$final_about_company =
			$about_company;

	}


	/* ---------------------------------------------------------
	 * BUSINESS EMAIL
	 * --------------------------------------------------------- */

	/*
	 * Client-supplied email is authoritative.
	 */

	$final_business_email =
		$business_email;


	/* ---------------------------------------------------------
	 * FINAL ARRAY
	 * --------------------------------------------------------- */

	return array(

		'headline' =>
			$final_headline,

		'sub_headline' =>
			$final_sub_headline,

		'announcement_type' =>
			$final_announcement_type,

		'date' =>
			$final_date,

		'city' =>
			$final_city,

		'image_url' =>
			$final_image_url,

		'dateline' =>
			$dateline,

		'sections' =>
			$sections,

		/*
		 * Keep body[] for compatibility with the existing
		 * frontend and integrations.
		 */

		'body' =>
			$body,

		'section_headings' =>
			$fixed_headings,

		'key_highlights' =>
			$highlights,

		'executive_comment' =>
			$executive_comment,

		'about_company' =>
			$final_about_company,

		'business_email' =>
			$final_business_email,

		'relevant_links' =>
			$links,

	);

}


/**
 * =========================================================
 * WORD COUNT
 * =========================================================
 *
 * This is INFORMATIONAL ONLY.
 *
 * There is deliberately NO:
 *
 * - minimum rejection
 * - maximum rejection
 * - retry
 * - second AI request
 *
 * The frontend receives the final word count so it can be
 * displayed or used elsewhere.
 *
 * Counted:
 *
 * - four section paragraphs
 * - executive comment
 *
 * Excluded:
 *
 * - headline
 * - subheadline
 * - headings
 * - metadata
 * - highlights
 * - About Company
 * - email
 * - links
 * =========================================================
 */

function gnn_count_text_words( $text ) {


	$text =
		trim(
			wp_strip_all_tags(
				(string) $text
			)
		);


	if (
		'' === $text
	) {

		return 0;

	}


	$words =
		preg_split(
			'/\s+/u',
			$text,
			-1,
			PREG_SPLIT_NO_EMPTY
		);


	return is_array(
		$words
	)
		? count( $words )
		: 0;

}


/**
 * =========================================================
 * COUNT PRESS RELEASE WORDS
 * =========================================================
 */

function gnn_count_press_release_words( $data ) {


	$text =
		'';


	/* ---------------------------------------------------------
	 * FOUR SECTION PARAGRAPHS
	 * --------------------------------------------------------- */

	if (
		isset( $data['sections'] ) &&
		is_array( $data['sections'] )
	) {


		foreach (
			$data['sections'] as $section
		) {


			if (
				! is_array( $section ) ||
				! isset( $section['paragraphs'] ) ||
				! is_array( $section['paragraphs'] )
			) {

				continue;

			}


			foreach (
				$section['paragraphs'] as $paragraph
			) {


				if (
					is_scalar( $paragraph )
				) {

					$text .=
						' ' .
						(string) $paragraph;

				}

			}

		}

	}


	/* ---------------------------------------------------------
	 * EXECUTIVE COMMENT
	 * --------------------------------------------------------- */

	if (
		isset( $data['executive_comment'] ) &&
		is_scalar( $data['executive_comment'] ) &&
		'' !== trim(
			(string) $data['executive_comment']
		)
	) {

		$text .=
			' ' .
			(string) $data['executive_comment'];

	}


	/* ---------------------------------------------------------
	 * FINAL COUNT
	 * --------------------------------------------------------- */

	$text =
		trim(
			wp_strip_all_tags(
				$text
			)
		);


	if (
		'' === $text
	) {

		return 0;

	}


	$words =
		preg_split(
			'/\s+/u',
			$text,
			-1,
			PREG_SPLIT_NO_EMPTY
		);


	return is_array(
		$words
	)
		? count( $words )
		: 0;

}
