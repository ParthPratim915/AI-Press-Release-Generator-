/**
 * =========================================================
 *
 * WORKING / SIMPLIFIED VERSION
 *
 * - Native WordPress AI Client
 * - Plain generate_text()
 * - Single AI generation pass
 * - Exactly 4 editorial sections
 * - AI internally targets minimum 400 words
 * - PHP counts generated words for information only
 * - NO minimum/maximum rejection
 * - NO second AI request
 * - NO JSON schema requirement
 * - NO quote word-count mathematics
 * - NO dynamic word-range mathematics
 * - Supplied image URL remains authoritative
 * - Supplied links remain authoritative
 * - Supplied business email remains authoritative
 * - 120-second server timeout
 *
 * IMPORTANT:
 * Uses the native WordPress AI Client.
 * No OpenAI API key is stored here.
 * =========================================================
 */


if ( ! defined( 'ABSPATH' ) ) {
	exit;
}


/**
 * =========================================================
 * AI CLIENT TIMEOUT
 * =========================================================
 *
 * The AI provider is allowed up to 120 seconds.
 *
 * This is only a maximum waiting time.
 * It does NOT make the AI itself faster or slower.
 * =========================================================
 */

add_filter(
	'wp_ai_client_default_request_timeout',
	function ( $timeout ) {

		return 120.0;

	}
);


/**
 * =========================================================
 * REGISTER REST ENDPOINT
 * =========================================================
 */

add_action(
	'rest_api_init',
	function () {

		register_rest_route(
			'gnn/v1',
			'/generate-pr',
			array(

				'methods' =>
					'POST',

				'callback' =>
					'gnn_generate_press_release',

				'permission_callback' =>
					'__return_true',

			)
		);

	}
);


/**
 * =========================================================
 * GENERATE PRESS RELEASE
 * =========================================================
 */

function gnn_generate_press_release( WP_REST_Request $request ) {


	/* ---------------------------------------------------------
	 * CHECK WORDPRESS AI CLIENT
	 * --------------------------------------------------------- */

	if ( ! function_exists( 'wp_ai_client_prompt' ) ) {

		return new WP_Error(
			'gnn_ai_unavailable',
			'The WordPress AI Client is not available. Please check the AI provider connection.',
			array(
				'status' => 503,
			)
		);

	}


	/* ---------------------------------------------------------
	 * BASIC RATE LIMIT
	 * --------------------------------------------------------- */

	$ip =
		isset( $_SERVER['REMOTE_ADDR'] )
			? sanitize_text_field(
				wp_unslash(
					$_SERVER['REMOTE_ADDR']
				)
			)
			: 'unknown';


	$rate_key =
		'gnn_pr_' .
		md5( $ip );


	if ( get_transient( $rate_key ) ) {

		return new WP_Error(
			'gnn_rate_limit',
			'Please wait a few seconds before generating another press release.',
			array(
				'status' => 429,
			)
		);

	}


	set_transient(
		$rate_key,
		true,
		15
	);


	/* ---------------------------------------------------------
	 * RECEIVE JSON DATA
	 * --------------------------------------------------------- */

	$params =
		$request->get_json_params();


	if ( ! is_array( $params ) ) {

		return new WP_Error(
			'gnn_invalid_request',
			'Invalid generator request.',
			array(
				'status' => 400,
			)
		);

	}


	/* ---------------------------------------------------------
	 * INPUT FIELDS
	 * --------------------------------------------------------- */

	$company =
		sanitize_text_field(
			$params['company_name'] ?? ''
		);


	$headline =
		sanitize_text_field(
			$params['headline'] ?? ''
		);


	$sub_headline =
		sanitize_text_field(
			$params['sub_headline'] ?? ''
		);


	$announcement_type =
		sanitize_text_field(
			$params['announcement_type'] ?? ''
		);


	$city =
		sanitize_text_field(
			$params['city'] ?? ''
		);


	$core_message =
		sanitize_textarea_field(
			$params['core_message'] ?? ''
		);


	$key_points =
		sanitize_textarea_field(
			$params['key_points'] ?? ''
		);


	$target_audience =
		sanitize_textarea_field(
			$params['target_audience'] ?? ''
		);


	$executive_quote =
		sanitize_textarea_field(
			$params['executive_quote'] ?? ''
		);


	$business_email =
		sanitize_email(
			$params['business_email'] ?? ''
		);


	$about_company =
		sanitize_textarea_field(
			$params['about_company'] ?? ''
		);


	$announcement_date =
		sanitize_text_field(
			$params['announcement_date'] ?? ''
		);


	$image_url =
		esc_url_raw(
			$params['image_url'] ?? ''
		);


	$relevant_links =
		sanitize_textarea_field(
			$params['relevant_links'] ?? ''
		);


	/* ---------------------------------------------------------
	 * REQUIRED VALIDATION
	 * --------------------------------------------------------- */

	if ( '' === $company ) {

		return new WP_Error(
			'gnn_missing_company',
			'Please enter the organization name.',
			array(
				'status' => 400,
			)
		);

	}


	if ( '' === $core_message ) {

		return new WP_Error(
			'gnn_missing_message',
			'Please enter the core message of the announcement.',
			array(
				'status' => 400,
			)
		);

	}


	/* ---------------------------------------------------------
	 * LIMIT INPUT SIZE
	 * --------------------------------------------------------- */

	$company =
		mb_substr(
			$company,
			0,
			250
		);


	$headline =
		mb_substr(
			$headline,
			0,
			400
		);


	$sub_headline =
		mb_substr(
			$sub_headline,
			0,
			500
		);


	$announcement_type =
		mb_substr(
			$announcement_type,
			0,
			150
		);


	$city =
		mb_substr(
			$city,
			0,
			150
		);


	$announcement_date =
		mb_substr(
			$announcement_date,
			0,
			100
		);


	$core_message =
		mb_substr(
			$core_message,
			0,
			7000
		);


	$key_points =
		mb_substr(
			$key_points,
			0,
			5000
		);


	$target_audience =
		mb_substr(
			$target_audience,
			0,
			1000
		);


	$executive_quote =
		mb_substr(
			$executive_quote,
			0,
			3000
		);


	$about_company =
		mb_substr(
			$about_company,
			0,
			5000
		);


	$image_url =
		mb_substr(
			$image_url,
			0,
			2000
		);


	$relevant_links =
		mb_substr(
			$relevant_links,
			0,
			5000
		);


	/* ---------------------------------------------------------
	 * DATE FALLBACK
	 * --------------------------------------------------------- */

	$current_date =
		wp_date(
			'F j, Y'
		);


	if ( '' === $announcement_date ) {

		$announcement_date =
			$current_date;

	}


	/* =========================================================
	 * AI PROMPT
	 * =========================================================
	 *
	 * IMPORTANT:
	 *
	 * There is deliberately NO mathematical word-count
	 * calculation before the AI request.
	 *
	 * The AI simply checks whether its main editorial content
	 * is approximately 400 words or more.
	 *
	 * PHP counts the final result afterward, but does NOT
	 * reject the result based on the count.
	 * =========================================================
	 */

	$prompt = <<<PROMPT
